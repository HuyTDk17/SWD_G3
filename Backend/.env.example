NODE_ENV=development
PORT=9999
MONGO_URI=mongodb://localhost:27017/language_learning
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
FRONTEND_URL=http://localhost:5173
API_BASE_URL=http://localhost:9999
GOOGLE_CLIENT_ID=
MEDIA_PROVIDER=local
UPLOAD_DIR=uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=learning-online

# SMTP settings for sending real emails (OTP verification, password reset, notifications).
# Leave these blank to keep the dev fallback: emails are logged to the console instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@languagelearning.com
